{
    "name": "ernestdefoe/anthology",
    "description": "Anthology — group discussions into series: novels, serials, tutorial parts. A cover page with a table of contents, reading progress, previous and next chapter on every chapter, and followers notified of each new chapter.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "series",
        "novel",
        "chapters",
        "fiction",
        "writing",
        "serial"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/anthology",
    "support": {
        "issues": "https://github.com/ernestdefoe/anthology/issues",
        "source": "https://github.com/ernestdefoe/anthology"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Anthology\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Anthology\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Anthology",
            "category": "feature",
            "icon": {
                "name": "fas fa-book-bookmark",
                "backgroundColor": "#7c3aed",
                "color": "#fff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
